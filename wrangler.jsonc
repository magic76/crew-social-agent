{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crew-social-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "SOCIAL_DB",
      "database_name": "crew-social-agent",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}