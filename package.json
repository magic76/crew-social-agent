{
  "name": "crew-social-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private owner-operated social inbox for Threads and Facebook Pages",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create crew-social-agent",
    "db:migrate:local": "wrangler d1 migrations apply SOCIAL_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SOCIAL_DB --remote"
  },
  "devDependencies": { "wrangler": "^4.45.0" },
  "engines": { "node": ">=22" }
}