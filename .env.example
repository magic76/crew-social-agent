# Copy to .env on your local computer (do not commit it).
THREADS_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Reuse the existing Pocket AES-256-GCM credential vault when available.
# Environment tokens above take precedence. Set this to "off" to disable it.
SOCIAL_AGENT_POCKET_VAULT_DIR=~/.crew-pocket/social

# Safe by default. Both this and an individual queue item's mode must be "live"
# before the Meta publisher is called. Also requires publish_permitted=true.
SOCIAL_AGENT_MODE=dry_run
SOCIAL_QUEUE_BRANCH=main
SOCIAL_POLL_INTERVAL_MS=1800000
SOCIAL_TIMEZONE=Asia/Taipei
SOCIAL_DAILY_SLOTS=12:00,19:00,21:00
SOCIAL_MAX_LATE_MINUTES=180
SOCIAL_AGENT_STATE_DIR=.crew-social-agent

# Live image/video URLs must be publicly readable HTTPS. Add only trusted hostnames.
SOCIAL_IMAGE_HOSTS=raw.githubusercontent.com
SOCIAL_VIDEO_HOSTS=raw.githubusercontent.com

# Pinned Graph API version. Update this after checking Meta's version changelog.
META_GRAPH_API_VERSION=v26.0
